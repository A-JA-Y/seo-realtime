# ─── Database (Neon) ──────────────────────────────────────────────────────────
# Pooled string (host contains "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Direct string (no "-pooler") — used by drizzle-kit migrations only.
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ─── Google Search Console ────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL="rank-tracker-gsc@rank-tracker-000000.iam.gserviceaccount.com"
# Keep the surrounding double quotes so the \n escapes survive dotenv parsing.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkq...\n-----END PRIVATE KEY-----\n"

# ─── DataForSEO ───────────────────────────────────────────────────────────────
DATAFORSEO_LOGIN="you@example.com"
# The API password from the DataForSEO dashboard, NOT your account login password.
DATAFORSEO_PASSWORD="your-api-password-from-the-dashboard"
# openssl rand -hex 32
DATAFORSEO_PINGBACK_SECRET="replace-me"

# ─── Cron & app ───────────────────────────────────────────────────────────────
# openssl rand -hex 32
CRON_SECRET="replace-me"
APP_BASE_URL="http://localhost:3000"

# ─── Auth.js ──────────────────────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET="replace-me"
AUTH_URL="http://localhost:3000"

# ─── Seed (optional) ──────────────────────────────────────────────────────────
# Password for the seeded agency_admin account. Defaults to a random value that
# the seed script prints once; set it explicitly for a reproducible local login.
SEED_ADMIN_EMAIL="mailtoajay7007@gmail.com"
SEED_ADMIN_PASSWORD=""
# Optional: also seed a `client` account scoped to the seeded property only,
# so the tenancy model can be exercised without provisioning by hand.
SEED_CLIENT_EMAIL=""
SEED_CLIENT_PASSWORD=""

# ─── Escape hatch ─────────────────────────────────────────────────────────────
# Set to "1" to skip env validation during `next build` in CI where secrets are
# injected at runtime rather than build time.
SKIP_ENV_VALIDATION=""
